    {
      "name": "保留结构化 state 和三种问题",
      "hook": "native",
      "member": "decision",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "clef",
              "state": {
                "body": "请退款",
                "flags": [
                  false,
                  0
                ]
              },
              "questions": {
                "refund": {
                  "type": "noul",
                  "instructions": {
                    "task": "需要退款吗？"
                  },
                  "criteria": {
                    "true": "需要退款"
                  }
                },
                "label": {
                  "type": "choice",
                  "instructions": [
                    "选择负责团队"
                  ],
                  "criteria": {
                    "billing": "付款",
                    "bug": null
                  }
                },
                "urgency": {
                  "type": "score",
                  "instructions": "有多紧急？",
                  "criteria": [
                    "普通",
                    "紧急"
                  ]
                }
              }
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "clef",
        "action": "decision",
        "requestBody": {
          "model": "clef",
          "state": {
            "body": "请退款",
            "flags": [
              false,
              0
            ]
          },
          "questions": {
            "refund": {
              "type": "noul",
              "instructions": {
                "task": "需要退款吗？"
              },
              "criteria": {
                "true": "需要退款"
              }
            },
            "label": {
              "type": "choice",
              "instructions": [
                "选择负责团队"
              ],
              "criteria": {
                "billing": "付款",
                "bug": null
              }
            },
            "urgency": {
              "type": "score",
              "instructions": "有多紧急？",
              "criteria": [
                "普通",
                "紧急"
              ]
            }
          }
        }
      }
