{
  "cases": [
    {
      "name": "搜索缺省模型和结果数",
      "hook": "native",
      "member": "search",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "query": "Ollama 云搜索"
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "ollama-web-search",
        "action": "search",
        "requestBody": {
          "query": "Ollama 云搜索",
          "max_results": 5
        }
      }
    },
    {
      "name": "搜索接受最大十条且不裁剪查询文本",
      "hook": "native",
      "member": "search",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "query": " news ",
              "max_results": 10,
              "model": "ollama-web-search"
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "ollama-web-search",
        "action": "search",
        "requestBody": {
          "query": " news ",
          "max_results": 10
        }
      }
    },
    {
