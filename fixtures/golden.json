    {
      "name": "构建云搜索请求及鉴权",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "ollama-web-search",
          "upstreamModel": "ollama-web-search",
          "action": "search",
          "publicTaskId": "task_public_123",
          "baseUrl": "https://ollama.com",
          "apiKey": "test-channel-key",
          "requestBody": {
            "query": "news",
            "max_results": 5
          }
        }
      ],
      "expected": {
        "url": "https://ollama.com/api/web_search",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "Bearer test-channel-key"
        },
        "body": {
          "query": "news",
          "max_results": 5
        }
      }
